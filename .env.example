# Frontend: URL backend v2, không có dấu / cuối. Không đưa secret vào biến VITE_*.
VITE_API_URL=https://YOUR-DEMO-SERVICE.onrender.com
# Backend production (Render Environment)
NODE_ENV=production
PORT=5000
CLIENT_URL=https://YOUR-DEMO-SITE.netlify.app
DB_MODE=firebase
DPL_DATABASE_PATH=environments/demo2026
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# Đặt các giá trị bên dưới ở Render Secrets, KHÔNG commit file .env thật.
FIREBASE_SERVICE_ACCOUNT_JSON=
JWT_SECRET=
